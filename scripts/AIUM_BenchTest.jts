function Test_Record()
{
	UpdateStatus("============Test_Record============");
	UpdateStatus($testType);
	if($recordItemTestType == 1)
	{
		//~ $msg = "->:" + $req + ",<-:" + $resp;
		//~ RecordMeasurementPassFail($SubTestName, $msg, $unit, "TRUE", $result);
		//~ $recordItemName = $SubTestName + "->Request";
		//~ RecordMeasurementPassFail($recordItemName, $req, $Send_Unit, "TRUE", $Send_Result);
		//~ $recordItemName = $SubTestName + "->Response";
		RecordMeasurementPassFail($recordItemName, $resp, $expectedContext, "TRUE", $recordItemResult);
	}
	if($recordItemTestType >= 2 && $recordItemTestType <= 6)
	{
		//~ $msg = "->:" + $req + ",<-:" + $resp;
		//~ RecordMeasurementPassFail($SubTestName, $msg, $unit, "TRUE", $result);
		//~ $recordItemName = $SubTestName + "->Request";
		//~ RecordMeasurementPassFail($recordItemName, $req, $Send_Unit, "TRUE", $Send_Result);
		//~ $recordItemName = $SubTestName + "->Response";
		//~ RecordMeasurementPassFail($recordItemName, $resp, $expectedContext, "TRUE", $Resonse_Result);
		RecordMeasurementPassFail($recordItemName, $recordItemValue, $recordItemUnit, "TRUE", $recordItemResult);
	}
	if($recordItemTestType == 7)
	{
		($lowerLimit, $upperLimit) = StringSplit($recordItemLimit,"~",2);
		//~ $recordItemName = $SubTestName + "->Request";
		//~ RecordMeasurementPassFail($recordItemName, $req, $Send_Unit, "TRUE", $Send_Result);
		//~ $recordItemName = $SubTestName + "->Response";
		//~ RecordMeasurementPassFail($recordItemName, $resp, $expectedContext, "TRUE", $Resonse_Result);
		RecordMeasurementWithLimits($recordItemName, $recordItemValue, $recordItemUnit, "TRUE", $lowerLimit, $upperLimit, true);
	}
	if($recordItemTestType == 8)
	{
		//~ $msg = "->:" + $req + ",<-:" + $resp;
		//~ RecordMeasurementPassFail($SubTestName, $msg, $unit, "TRUE", $result);
		//~ $recordItemName = $SubTestName + "->Request";
		//~ RecordMeasurementPassFail($recordItemName, $req, $Send_Unit, "TRUE", $Send_Result);
		//~ $recordItemName = $SubTestName + "->Response";
		RecordMeasurementPassFail($recordItemName, $resp, $recordItemUnit, "TRUE", $recordItemResult);
	}
	if($recordItemTestType == 9)
	{
		RecordMeasurementPassFail($recordItemName, $recordItemValue, $recordItemUnit, "TRUE", $recordItemResult);
	}
	return;
}
function Doip_Excel_Step()
{
	// ---------------------------------------------------------------------------
	// 用法 2：Excel 直读单步（共享 EonTest 的测试工步表）
	// ---------------------------------------------------------------------------
	UpdateStatus("===================Start Doip_Excel_Step===================");
	// 直接传工步号，函数内部读该行的 G 列（配置参数1）+ P 列（解码配置）执行
	$testExcel = "E:\\SourceCode\\EonTest\\Workflows\\real-device-acceptance.xlsx";
	$stepLoop = 2;
	while($stepLoop < 42)
	{
		UpdateStatus($stepLoop);
		($result, $testItem, $req, $resp, $value, $unit, $limits, $testType)  = DoIP_UDS_ExcelStep($testExcel, "StepTable", $stepLoop);
		$updateStr = $result + "\n" + $testItem + "\n" + $req + "\n" + $resp + "\n" + $value + "\n" + $unit + "\n" + $limits + "\n" + $testType;
		UpdateStatus($updateStr);
		$ismulItem = StringContains($result,"|");
		SetTestName($testItem);
		if($ismulItem)
		{
			$ismulItem1 = StringContains($testItem,"|");
			$ismulItem2 = StringContains($value,"|");
			if($ismulItem1 && $ismulItem2)
			{
				$itemArray = StringSplitToArray($testItem, "|", 10);
				$valueArray = StringSplitToArray($value, "|", 10);
				$unitArray = StringSplitToArray($unit, "|", 10);
				$arrayLength = ArrayGetLength($itemArray);
				$recordLoop = 0;
				while($recordLoop < $arrayLength)
				{
					$recordItemName = Array1DGetValue($itemArray, $recordLoop);
					$recordItemValue = Array1DGetValue($valueArray, $recordLoop);
					$recordItemUnit = Array1DGetValue($unitArray, $recordLoop);
					RecordMeasurementPassFail($recordItemName, $recordItemValue, $recordItemUnit, "TRUE", $result);
					$recordLoop = $recordLoop + 1;
				}
			}
			if( !$ismulItem1 || !$ismulItem2)
			{
				RecordMeasurementPassFail($testItem, $value, $unit, "TRUE", $result);
			}
		}
		if($testType == 7)
		{
			($lowerLimit, $upperLimit) = StringSplit($limits,"~",2);
			RecordMeasurementWithLimits($testItem, $value, $unit, "TRUE", $lowerLimit, $upperLimit, true);
		}
		if($testType == 1)
		{
			$msg = "->:" + $req + ",<-:" + $resp;
			RecordMeasurementPassFail($testItem, $msg, $unit, "TRUE", $result);
		}
		if($testType >= 2 && $testType <= 6)
		{
			$msg = "->:" + $req + ",<-:" + $resp;
			RecordMeasurementPassFail($testItem, $msg, $unit, "TRUE", $result);
		}
		if($testType == 8)
		{
			$msg = "->:" + $req + ",<-:" + $resp;
			RecordMeasurementPassFail($testItem, $msg, $unit, "TRUE", $result);
		}
		if($testType == 9)
		{
			RecordMeasurementPassFail($testItem, $value, $unit, "TRUE", $result);
		}
		$stepLoop = $stepLoop + 1;
		SleepMilliseconds(50);
	}
	UpdateStatus("===================Stop Doip_Excel_Step===================");
	return;
}

function Doip_Test_Step()
{
	// ---------------------------------------------------------------------------
	// 用法 2：Excel 直读单步（共享 EonTest 的测试工步表）
	// ---------------------------------------------------------------------------
	UpdateStatus("===================Start Doip_Test_Step===================");
	// 直接传工步号，函数内部读该行的 G 列（配置参数1）+ P 列（解码配置）执行
	$testExcel = "E:\\SourceCode\\EonTest\\Workflows\\HRU_Final.xlsx";
	$excelFile = $testExcel;
    $sheetNum 		= 1; //sheet
    $startCol 		    = "A";
    $startRow 		= 3;
    $endCol 		    = "M";
    $endRow 			= 41;
    call LoadExcelConfigFile();
	$rows_Num=0;
    $rows_Last = $rows_Length - 1;
    $testStep_Loop = 0;
	$stepLoop = 2;
	while($rows_Num<$rows_Length)
	{
		$rowArray 	    = Array1DGetRowFrom2D($sheet_array, $rows_Num); //Read row 
		$isTest = Array1DGetValue($rowArray ,1);
		$TestName		= Array1DGetValue($rowArray ,2);
		$SubTestName= Array1DGetValue($rowArray ,3);
		$action= Array1DGetValue($rowArray ,5);
		$requestConfig		= Array1DGetValue($rowArray ,6);
		$decodeConfig	= Array1DGetValue($rowArray ,7); 
		$lowLimit	= Array1DGetValue($rowArray ,8); 
		$upLimit  = Array1DGetValue($rowArray ,9); 
		$Uint  = Array1DGetValue($rowArray ,10); 
		//string trim
		$isTest = StringTrim($isTest);
		$TestName = StringTrim($TestName);
		$SubTestName = StringTrim($SubTestName);
		$action = StringTrim($action);
		$requestConfig = StringTrim($requestConfig);
		$decodeConfig = StringTrim($decodeConfig);
		$lowLimit = StringTrim($lowLimit);
		$upLimit = StringTrim($upLimit);
		$Uint = StringTrim($Uint);
		//~ if($rows_Num == 0)
		//~ {
			//~ $requestConfig = "host=172.16.0.8,port=13400," + $requestConfig;
		//~ }
		UpdateStatus($isTest);
		UpdateStatus($TestName);
		UpdateStatus($SubTestName);
		UpdateStatus($action);
		UpdateStatus($requestConfig);
		UpdateStatus($decodeConfig);
		UpdateStatus($lowLimit);
		UpdateStatus($upLimit);
		UpdateStatus($Uint);
		$rows_Num= $rows_Num + 1;
		$Send_Result = true;
		$Send_Unit = "hex";
		$Resonse_Result = true;
		if($action == "send_uds")
		{
			($result, $testItem, $req, $resp, $value, $unit, $limits, $testType) = DoIP_UDS_Step($requestConfig,$decodeConfig,$Doip_Sension_Name,$lowLimit,$upLimit,$Uint);
			$expectedContext = $Result_step_expectedContext;
			$updateStr = $result + "\n" + $testItem + "\n" + $req + "\n" + $resp + "\n" + $value + "\n" + $unit + "\n" + $limits + "\n" + $testType + "\n" + $expectedContext;
			UpdateStatus($updateStr);
			$ismulItem = StringContains($result,"|");
			if($ismulItem)
			{
				$resultArray = StringSplitToArray($result, "|", 20);
				$result = Array1DGetValue($itemArray, 0)
			}
			if(!$result)
			{
				$stage = $Result_step_FailureStage;
				UpdateStatus($stage);
				if($stage == "CONNECT" || $stage == "EXECUTION" || $stage == "ROUTING" || $stage == "CONFIG" )
				{
					$error = $Result_step_Error;
					UpdateStatus($error);
					RecordMeasurementPassFail($SubTestName, $error, "", "TRUE", false);
					Fail($error);
				}
				if($stage == "SEND")
				{
					$Send_Result = false;
					$Resonse_Result = false;
				}
				if($stage == "TIMEOUT" || $stage == "RESPONSE_MISMATCH")
				{
					$Resonse_Result = false;
				}
			}
			//~ $ismulItem = StringContains($testItem,"|");
			SetTestName($TestName);
			//~ SetTestGroupName($TestName);
			if($ismulItem)
			{
				$ismulItem1 = StringContains($testItem,"|");
				$ismulItem2 = StringContains($value,"|");
				if($ismulItem1 && $ismulItem2)
				{
					$itemArray = StringSplitToArray($testItem, "|", 20);
					$valueArray = StringSplitToArray($value, "|", 20);
					$unitArray = StringSplitToArray($unit, "|", 20);
					$arrayLength = ArrayGetLength($itemArray);
					$recordItemName = $SubTestName + "->Request";
					RecordMeasurementPassFail($recordItemName, $req, $Send_Unit, "TRUE", $Send_Result);
					$recordItemName = $SubTestName + "->Response";
					RecordMeasurementPassFail($recordItemName, $resp, $expectedContext, "TRUE", $Resonse_Result);
					$recordLoop = 0;
					while($recordLoop < $arrayLength)
					{
						$recordItemName = Array1DGetValue($itemArray, $recordLoop);
						$recordItemValue = Array1DGetValue($valueArray, $recordLoop);
						$recordItemUnit = Array1DGetValue($unitArray, $recordLoop);
						$recordItemResult = Array1DGetValue($resultArray, $recordLoop);
						RecordMeasurementPassFail($recordItemName, $recordItemValue, $recordItemUnit, "TRUE", $recordItemResult);
						$recordLoop = $recordLoop + 1;
					}
				}
				if( !$ismulItem1 || !$ismulItem2)
				{
					RecordMeasurementPassFail($testItem, $value, $unit, "TRUE", $result);
				}
			}
			if($testType == 7)
			{
				($lowerLimit, $upperLimit) = StringSplit($limits,"~",2);
				$recordItemName = $SubTestName + "->Request";
				RecordMeasurementPassFail($recordItemName, $req, $Send_Unit, "TRUE", $Send_Result);
				$recordItemName = $SubTestName + "->Response";
				RecordMeasurementPassFail($recordItemName, $resp, $expectedContext, "TRUE", $Resonse_Result);
				RecordMeasurementWithLimits($SubTestName, $value, $unit, "TRUE", $lowerLimit, $upperLimit, true);
			}
			if($testType == 1)
			{
				//~ $msg = "->:" + $req + ",<-:" + $resp;
				//~ RecordMeasurementPassFail($SubTestName, $msg, $unit, "TRUE", $result);
				$recordItemName = $SubTestName + "->Request";
				RecordMeasurementPassFail($recordItemName, $req, $Send_Unit, "TRUE", $Send_Result);
				$recordItemName = $SubTestName + "->Response";
				RecordMeasurementPassFail($recordItemName, $resp, $expectedContext, "TRUE", $Resonse_Result);
			}
			if($testType >= 2 && $testType <= 6)
			{
				//~ $msg = "->:" + $req + ",<-:" + $resp;
				//~ RecordMeasurementPassFail($SubTestName, $msg, $unit, "TRUE", $result);
				
				$recordItemName = $SubTestName + "->Request";
				RecordMeasurementPassFail($recordItemName, $req, $Send_Unit, "TRUE", $Send_Result);
				$recordItemName = $SubTestName + "->Response";
				RecordMeasurementPassFail($recordItemName, $resp, $expectedContext, "TRUE", $Resonse_Result);
				RecordMeasurementPassFail($SubTestName, $value, $unit, "TRUE", $result);
			}
			if($testType == 8)
			{
				//~ $msg = "->:" + $req + ",<-:" + $resp;
				//~ RecordMeasurementPassFail($SubTestName, $msg, $unit, "TRUE", $result);
				$recordItemName = $SubTestName + "->Request";
				RecordMeasurementPassFail($recordItemName, $req, $Send_Unit, "TRUE", $Send_Result);
				$recordItemName = $SubTestName + "->Response";
				RecordMeasurementPassFail($recordItemName, $resp, $unit, "TRUE", $result);
			}
			if($testType == 9)
			{
				RecordMeasurementPassFail($SubTestName, $value, $unit, "TRUE", $result);
			}
			$stepLoop = $stepLoop + 1;
			SleepMilliseconds(50);
		}
		if($action == "delay")
		{
			($name,$delayTime) = StringSplit($requestConfig,"=",2);
			$delayTime = StringTrim($delayTime);
			SleepMilliseconds($delayTime);
		}
	}
	UpdateStatus("===================Stop Doip_Test_Step===================");
	return;
}
function CAN_Test_Step_Old()
{
	// ---------------------------------------------------------------------------
	// 用法 2：Excel 直读单步（共享 EonTest 的测试工步表）
	// ---------------------------------------------------------------------------
	UpdateStatus("===================Start Doip_Test_Step===================");
	// 直接传工步号，函数内部读该行的 G 列（配置参数1）+ P 列（解码配置）执行
	$testExcel = "E:\\SourceCode\\EonTest\\Workflows\\AIUM_Eol.xlsx";
