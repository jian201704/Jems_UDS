// 前置：把dll拷贝到
//       D:\Projects\ZEEKR\Software\JEMSts_8.55.00x64\Modules\UserLibraries\
// 本脚本演示三种用法：
//   1) 配置驱动单步  DoIP_UDS_Step   （G 列原文 + P 列解码配置）
//   2) Excel 直读单步 DoIP_UDS_ExcelStep （按工步号读共享 Excel）
//   3) Excel 一键全跑 DoIP_UDS_ExcelRunAll （整张表的 UDS 步骤）
// ============================================================================
SetFinalizeFunction("Cleanup");
$Doip_Sension_Name = "HRU_Doip";
$CAN_Key_Name = "AIUM_CAN";
//~ call Doip_Excel_Step();
//~ call Doip_Test_Step();
CAN_UDS_Init("D:\\Software\\JEMSts_8.65.00\\Modules\\UserLibraries\\Jabil.Uds.Can.Zlg.dll", "ZLGAPI.ZlgCanDeviceProvider", "41", "F502B111F0CC0AB49E90", $CAN_Key_Name);
CAN_SetFilter($CAN_Key_Name, 0, "0", "0x700", "0x7FF");
CAN_EnableFilter($CAN_Key_Name, 0);

	CAN_SetDeviceValue($CAN_Key_Name, "0/initenal_resistance", "1");
	
	CAN_OpenChannel(1, 1, 1, 1000, 5000, 0, 0, $CAN_Key_Name);
	CAN_SetDeviceValue($CAN_Key_Name, "1/baud_rate_custom", "1.0Mbps(66%),5.0Mbps(75%),(60,04C00000,00800001)");
	CAN_SetDeviceValue($CAN_Key_Name, "1/initenal_resistance", "1");
//~ Sleep(2);
//~ CAN_UDS_Step("transport=can,canDeviceKey=AIUM_CAN,canChannel=0,canFd=true,canBitRateSwitch=true,canNominalBitrate=500000,canDataBitrate=2000000,canFdStandard=0,canFdMode=0,canRequestId=0x709,canResponseId=0x789,udsPayload=10 01,expectedPrefix=50 01","","AIUM_CAN");
//~ Sleep(20);
//~ CAN_UDS_Release();
call CAN_Test_Step();

End;
