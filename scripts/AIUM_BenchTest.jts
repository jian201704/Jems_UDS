function LoadExcelConfigFile()
{
    UpdateStatus("============Load Execel File Begin============");

    $excelHandle = ExcelOpenFile($excelFile);
    $sheet_array = ExcelGetRange($excelHandle, $sheetNum, $startCol, $startRow, $endCol, $endRow); 
    ExcelCloseFile($excelHandle);
    $dataArray_len= ArrayGetLength($sheet_array);		// 一维数组
    $rows_Length = ArrayGetDimensionSize($sheet_array, 0); 
    $cols_Length = ArrayGetDimensionSize($sheet_array, 1);  
    $Display="The rows_Length is:"+$rows_Length+", The columns_Length is:"+$cols_Length;
    UpdateStatus($Display);
    UpdateStatus("============Load Execel File End============");
    return;
}
function Cleanup()
{
	UpdateStatus("===================Start Cleanup===================");
	//~ DoIP_UDS_Release($Doip_Sension_Name);
	CAN_UDS_Release();
	UpdateStatus("===================Stop Cleanup===================");
	End;
}
